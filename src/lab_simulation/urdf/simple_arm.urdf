<?xml version="1.0"?>
<!--
  simple_arm.urdf

  ROS description of the 3-DOF lab arm, consumed by robot_state_publisher,
  RViz and (later) MoveIt.

  Gazebo does not load this file; it simulates worlds/simple_arm.sdf. The two
  must agree on link geometry, inertia, joint names, axes, origins and limits,
  and the package test `test/test_robot_description.py` enforces this.

  Frame convention: every link frame sits on the joint that drives it, and the
  link geometry is offset by half its length along +Z, so links stack end to
  end.

    world -> base_link   fixed, base on the table top (z = 0.75 m)
    joint_1              revolute about Z, base yaw
    joint_2              revolute about Y, shoulder pitch
    joint_3              revolute about Y, elbow pitch
    end_effector_joint   fixed, tool point at the tip of link_3

  Shoulder and elbow range is ±135°: with ±90° the table is unreachable.

  Inertia tensors are those of the solid primitive about its centre of mass.
-->
<robot name="simple_arm">

  <material name="dark_gray"><color rgba="0.3 0.3 0.3 1.0"/></material>
  <material name="blue"><color rgba="0.1 0.3 0.8 1.0"/></material>
  <material name="green"><color rgba="0.1 0.7 0.2 1.0"/></material>
  <material name="red"><color rgba="0.8 0.1 0.1 1.0"/></material>
  <material name="yellow"><color rgba="0.9 0.9 0.1 1.0"/></material>

  <!-- Massless root frame. Must match the arm's <include> pose in table_world.sdf. -->
  <link name="world"/>

  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.75" rpy="0 0 0"/>
  </joint>

  <!-- Base mount. Frame at the mounting surface. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><cylinder radius="0.08" length="0.04"/></geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><cylinder radius="0.08" length="0.04"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.003467" ixy="0" ixz="0" iyy="0.003467" iyz="0" izz="0.0064"/>
    </inertial>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="20" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- Link 1: vertical column. -->
  <link name="link_1">
    <visual>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 0.25"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 0.25"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.005508" ixy="0" ixz="0" iyy="0.005508" iyz="0" izz="0.0006"/>
    </inertial>
  </link>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.356" upper="2.356" effort="15" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- Link 2: upper arm. -->
  <link name="link_2">
    <visual>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.20"/></geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.20"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.002833" ixy="0" ixz="0" iyy="0.002833" iyz="0" izz="0.0003333"/>
    </inertial>
  </link>

  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 0 0.20" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.356" upper="2.356" effort="10" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- Link 3: forearm. -->
  <link name="link_3">
    <visual>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.15"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.15"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.001004" ixy="0" ixz="0" iyy="0.001004" iyz="0" izz="0.0001333"/>
    </inertial>
  </link>

  <joint name="end_effector_joint" type="fixed">
    <parent link="link_3"/>
    <child link="end_effector"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

  <!-- Tool point. A gripper will attach here. -->
  <link name="end_effector">
    <visual>
      <geometry><sphere radius="0.025"/></geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.025"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

</robot>
