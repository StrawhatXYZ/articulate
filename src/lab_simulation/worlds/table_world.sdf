<?xml version="1.0"?>
<!--
  table_world.sdf

  A simple Gazebo world with:
    - A ground plane
    - A table (1 m x 1 m, top surface at z = 0.75 m)
    - Three coloured objects on the table for the arm to interact with
    - The 3-DOF arm, included from simple_arm.sdf and welded to the table top
    - A directional light source

  Loaded by launch/arm_world.launch.py, which adds this package's worlds/
  directory to GZ_SIM_RESOURCE_PATH so the model:// include resolves.
-->
<sdf version="1.8">
  <world name="table_world">

    <!-- Physics settings: 1ms time step, real-time simulation -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ══════════════════════════════════════════════════════════════
         GROUND PLANE
         A flat surface at z=0 that catches shadows and provides
         a visual reference.
         ══════════════════════════════════════════════════════════════ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1.0</ambient>
            <diffuse>0.15 0.15 0.15 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════════════════════
         TABLE
         A 1m x 1m table, 75cm tall. The arm will be placed on top.
         ══════════════════════════════════════════════════════════════ -->
    <model name="table">
      <static>true</static>
      <link name="table_link">
        <collision name="table_collision">
          <geometry>
            <box>
              <size>1.0 1.0 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="table_visual">
          <geometry>
            <box>
              <size>1.0 1.0 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.4 0.2 1.0</ambient>
            <diffuse>0.6 0.4 0.2 1.0</diffuse>
          </material>
        </visual>
      </link>
      <!-- Table top surface is at z=0.75 -->
      <pose>0 0 0.725 0 0 0</pose>
    </model>

    <!-- ══════════════════════════════════════════════════════════════
         OBJECTS ON THE TABLE
         Three simple objects the arm can try to pick up.
         Each is 100 g, with the inertia of its solid primitive.
         Default positions are 0.20 m from the base axis, inside the arm's reach.
         ══════════════════════════════════════════════════════════════ -->

    <!-- Red cube -->
    <model name="red_cube">
      <link name="cube_link">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0000417</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0000417</iyy><iyz>0</iyz><izz>0.0000417</izz>
          </inertia>
        </inertial>
        <collision name="cube_collision">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="cube_visual">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1.0</ambient>
            <diffuse>0.8 0.1 0.1 1.0</diffuse>
          </material>
        </visual>
      </link>
      <pose>0.173 0.10 0.775 0 0 0</pose>
      <!-- Publishes this piece's world pose on /model/<name>/pose. -->
      <plugin filename="gz-sim-pose-publisher-system"
              name="gz::sim::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>false</publish_link_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <update_frequency>50</update_frequency>
      </plugin>
    </model>

    <!-- Blue cylinder -->
    <model name="blue_cylinder">
      <link name="cylinder_link">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.000106</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.000106</iyy><iyz>0</iyz><izz>0.000045</izz>
          </inertia>
        </inertial>
        <collision name="cylinder_collision">
          <geometry>
            <cylinder>
              <radius>0.03</radius>
              <length>0.10</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="cylinder_visual">
          <geometry>
            <cylinder>
              <radius>0.03</radius>
              <length>0.10</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.8 1.0</ambient>
            <diffuse>0.1 0.1 0.8 1.0</diffuse>
          </material>
        </visual>
      </link>
      <pose>-0.173 0.10 0.80 0 0 0</pose>
      <!-- Publishes this piece's world pose on /model/<name>/pose. -->
      <plugin filename="gz-sim-pose-publisher-system"
              name="gz::sim::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>false</publish_link_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <update_frequency>50</update_frequency>
      </plugin>
    </model>

    <!-- Green sphere -->
    <model name="green_sphere">
      <link name="sphere_link">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.000064</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.000064</iyy><iyz>0</iyz><izz>0.000064</izz>
          </inertia>
        </inertial>
        <collision name="sphere_collision">
          <geometry>
            <sphere>
              <radius>0.04</radius>
            </sphere>
          </geometry>
        </collision>
        <visual name="sphere_visual">
          <geometry>
            <sphere>
              <radius>0.04</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.1 0.7 0.2 1.0</ambient>
            <diffuse>0.1 0.7 0.2 1.0</diffuse>
          </material>
        </visual>
      </link>
      <pose>0.0 -0.20 0.79 0 0 0</pose>
      <!-- Publishes this piece's world pose on /model/<name>/pose. -->
      <plugin filename="gz-sim-pose-publisher-system"
              name="gz::sim::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>false</publish_link_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <update_frequency>50</update_frequency>
      </plugin>
    </model>

    <!-- ══════════════════════════════════════════════════════════════
         ROBOT ARM

         Included directly into the world rather than spawned at runtime, so
         the system plugins declared inside the model (joint controllers and
         joint state publisher) are loaded with the world.

         This <pose> is the single source of the arm's placement: it replaces
         any pose inside the included model. It places base_link on the table
         top and must match the world_joint origin in simple_arm.urdf.
         ══════════════════════════════════════════════════════════════ -->
    <include>
      <uri>model://simple_arm.sdf</uri>
      <name>simple_arm</name>
      <pose>0 0 0.75 0 0 0</pose>

      <!--
        Simulated suction: one DetachableJoint per piece, fixing the piece to
        the end effector at its current offset. Declared here rather than in
        simple_arm.sdf so the arm model does not name this world's pieces.
        lab_simulation.scene engages suction only when the tip is within 5 mm
        of the piece (layout.GRASP_GAP_MAX).
      -->
      <plugin filename="gz-sim-detachable-joint-system"
              name="gz::sim::systems::DetachableJoint">
        <parent_link>end_effector</parent_link>
        <child_model>red_cube</child_model>
        <child_link>cube_link</child_link>
        <attach_topic>/simple_arm/suction/red_cube/attach</attach_topic>
        <detach_topic>/simple_arm/suction/red_cube/detach</detach_topic>
        <suppress_child_warning>true</suppress_child_warning>
      </plugin>
      <plugin filename="gz-sim-detachable-joint-system"
              name="gz::sim::systems::DetachableJoint">
        <parent_link>end_effector</parent_link>
        <child_model>blue_cylinder</child_model>
        <child_link>cylinder_link</child_link>
        <attach_topic>/simple_arm/suction/blue_cylinder/attach</attach_topic>
        <detach_topic>/simple_arm/suction/blue_cylinder/detach</detach_topic>
        <suppress_child_warning>true</suppress_child_warning>
      </plugin>
      <plugin filename="gz-sim-detachable-joint-system"
              name="gz::sim::systems::DetachableJoint">
        <parent_link>end_effector</parent_link>
        <child_model>green_sphere</child_model>
        <child_link>sphere_link</child_link>
        <attach_topic>/simple_arm/suction/green_sphere/attach</attach_topic>
        <detach_topic>/simple_arm/suction/green_sphere/detach</detach_topic>
        <suppress_child_warning>true</suppress_child_warning>
      </plugin>
    </include>

    <!-- ══════════════════════════════════════════════════════════════
         LIGHT
         A directional light source so we can see the scene.
         ══════════════════════════════════════════════════════════════ -->
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

  </world>
</sdf>
