<?xml version="1.0"?>
<!--
  table_world.sdf

  A simple Gazebo world with:
    - A ground plane
    - A table (1 m x 1 m, top surface at z = 0.75 m)
    - Three coloured pieces on the table for the SO-101 to pick
    - Three open sorting bins, one per piece colour
    - A directional light source

  The SO-101 is not part of the world: arm_world.launch.py spawns it from
  robot_description (urdf/lab_so101.urdf.xacro), the single description
  shared by Gazebo, RViz and MoveIt.
-->
<sdf version="1.8">
  <world name="table_world">

    <!-- World systems. Listing any system replaces Gazebo's defaults, so
         physics, user commands (teleport, lights) and the scene broadcaster
         are listed with the sensors system that renders the overhead camera
         (spawned only with perception:=true). -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Physics settings: 1ms time step, real-time simulation -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ══════════════════════════════════════════════════════════════
         GROUND PLANE
         A flat surface at z=0 that catches shadows and provides
         a visual reference.
         ══════════════════════════════════════════════════════════════ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1.0</ambient>
            <diffuse>0.15 0.15 0.15 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════════════════════
         TABLE
         A 1m x 1m table, 75cm tall. The SO-101 stands at its centre, spawned
         from robot_description by arm_world.launch.py.
         ══════════════════════════════════════════════════════════════ -->
    <model name="table">
      <static>true</static>
      <link name="table_link">
        <collision name="table_collision">
          <geometry>
            <box>
              <size>1.0 1.0 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="table_visual">
          <geometry>
            <box>
              <size>1.0 1.0 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.4 0.2 1.0</ambient>
            <diffuse>0.6 0.4 0.2 1.0</diffuse>
          </material>
        </visual>
      </link>
      <!-- Table top surface is at z=0.75 -->
      <pose>0 0 0.725 0 0 0</pose>
    </model>

    <!-- ══════════════════════════════════════════════════════════════
         OBJECTS ON THE TABLE
         Three pieces sized for the SO-101's jaws: each is 3 cm across the
         side the jaws close on. Inertias are those of the solid primitive.
         Default positions are inside the arm's workspace (layout.py).
         ══════════════════════════════════════════════════════════════ -->

    <!-- Red cube: 3 cm -->
    <model name="red_cube">
      <link name="cube_link">
        <inertial>
          <mass>0.03</mass>
          <inertia>
            <ixx>4.5e-06</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>4.5e-06</iyy><iyz>0</iyz><izz>4.5e-06</izz>
          </inertia>
        </inertial>
        <collision name="cube_collision">
          <geometry>
            <box>
              <size>0.03 0.03 0.03</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="cube_visual">
          <geometry>
            <box>
              <size>0.03 0.03 0.03</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1.0</ambient>
            <diffuse>0.8 0.1 0.1 1.0</diffuse>
          </material>
        </visual>
      </link>
      <pose>0.215 -0.036 0.765 0 0 0</pose>
      <!-- Publishes this piece's world pose on /model/<name>/pose. -->
      <plugin filename="gz-sim-pose-publisher-system"
              name="gz::sim::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>false</publish_link_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <update_frequency>50</update_frequency>
      </plugin>
    </model>

    <!-- Blue cylinder: 3 cm across, 5 cm tall -->
    <model name="blue_cylinder">
      <link name="cylinder_link">
        <inertial>
          <mass>0.035</mass>
          <inertia>
            <ixx>9.26e-06</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>9.26e-06</iyy><iyz>0</iyz><izz>3.938e-06</izz>
          </inertia>
        </inertial>
        <collision name="cylinder_collision">
          <geometry>
            <cylinder>
              <radius>0.015</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="cylinder_visual">
          <geometry>
            <cylinder>
              <radius>0.015</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.8 1.0</ambient>
            <diffuse>0.1 0.1 0.8 1.0</diffuse>
          </material>
        </visual>
      </link>
      <pose>0.164 -0.129 0.775 0 0 0</pose>
      <!-- Publishes this piece's world pose on /model/<name>/pose. -->
      <plugin filename="gz-sim-pose-publisher-system"
              name="gz::sim::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>false</publish_link_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <update_frequency>50</update_frequency>
      </plugin>
    </model>

    <!-- Green block: 5 x 3 x 3 cm, gripped across its 3 cm width -->
    <model name="green_block">
      <link name="block_link">
        <inertial>
          <mass>0.045</mass>
          <inertia>
            <ixx>6.75e-06</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1.275e-05</iyy><iyz>0</iyz><izz>1.275e-05</izz>
          </inertia>
        </inertial>
        <collision name="block_collision">
          <geometry>
            <box>
              <size>0.05 0.03 0.03</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="block_visual">
          <geometry>
            <box>
              <size>0.05 0.03 0.03</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.7 0.2 1.0</ambient>
            <diffuse>0.1 0.7 0.2 1.0</diffuse>
          </material>
        </visual>
      </link>
      <pose>0.069 -0.177 0.765 0 0 0</pose>
      <!-- Publishes this piece's world pose on /model/<name>/pose. -->
      <plugin filename="gz-sim-pose-publisher-system"
              name="gz::sim::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>false</publish_link_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <update_frequency>50</update_frequency>
      </plugin>
    </model>

    <!-- ══════════════════════════════════════════════════════════════
         SORTING BINS
         Open boxes (walls only) on the arm's left, one per piece colour,
         turned to face the arm. Generated from layout.BINS; the tests check
         that they match.
         ══════════════════════════════════════════════════════════════ -->

    <model name="green_bin">
      <static>true</static>
      <pose>0.2093 0.1045 0.75 0 0 0.55</pose>
      <link name="link">
        <collision name="wall_0_collision">
          <pose>0.0475 0.0000 0.0100 0 0 0</pose>
          <geometry><box><size>0.0050 0.1000 0.0200</size></box></geometry>
        </collision>
        <visual name="wall_0_visual">
          <pose>0.0475 0.0000 0.0100 0 0 0</pose>
          <geometry><box><size>0.0050 0.1000 0.0200</size></box></geometry>
          <material>
            <ambient>0.1 0.7 0.2 1.0</ambient>
            <diffuse>0.1 0.7 0.2 1.0</diffuse>
          </material>
        </visual>
        <collision name="wall_1_collision">
          <pose>-0.0475 0.0000 0.0100 0 0 0</pose>
          <geometry><box><size>0.0050 0.1000 0.0200</size></box></geometry>
        </collision>
        <visual name="wall_1_visual">
          <pose>-0.0475 0.0000 0.0100 0 0 0</pose>
          <geometry><box><size>0.0050 0.1000 0.0200</size></box></geometry>
          <material>
            <ambient>0.1 0.7 0.2 1.0</ambient>
            <diffuse>0.1 0.7 0.2 1.0</diffuse>
          </material>
        </visual>
        <collision name="wall_2_collision">
          <pose>0.0000 0.0475 0.0100 0 0 0</pose>
          <geometry><box><size>0.0900 0.0050 0.0200</size></box></geometry>
        </collision>
        <visual name="wall_2_visual">
          <pose>0.0000 0.0475 0.0100 0 0 0</pose>
          <geometry><box><size>0.0900 0.0050 0.0200</size></box></geometry>
          <material>
            <ambient>0.1 0.7 0.2 1.0</ambient>
            <diffuse>0.1 0.7 0.2 1.0</diffuse>
          </material>
        </visual>
        <collision name="wall_3_collision">
          <pose>0.0000 -0.0475 0.0100 0 0 0</pose>
          <geometry><box><size>0.0900 0.0050 0.0200</size></box></geometry>
        </collision>
        <visual name="wall_3_visual">
          <pose>0.0000 -0.0475 0.0100 0 0 0</pose>
          <geometry><box><size>0.0900 0.0050 0.0200</size></box></geometry>
          <material>
            <ambient>0.1 0.7 0.2 1.0</ambient>
            <diffuse>0.1 0.7 0.2 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="red_bin">
      <static>true</static>
      <pose>0.1349 0.1754 0.75 0 0 1.07</pose>
      <link name="link">
        <collision name="wall_0_collision">
          <pose>0.0475 0.0000 0.0100 0 0 0</pose>
          <geometry><box><size>0.0050 0.1000 0.0200</size></box></geometry>
        </collision>
        <visual name="wall_0_visual">
          <pose>0.0475 0.0000 0.0100 0 0 0</pose>
          <geometry><box><size>0.0050 0.1000 0.0200</size></box></geometry>
          <material>
            <ambient>0.8 0.1 0.1 1.0</ambient>
            <diffuse>0.8 0.1 0.1 1.0</diffuse>
          </material>
        </visual>
        <collision name="wall_1_collision">
          <pose>-0.0475 0.0000 0.0100 0 0 0</pose>
          <geometry><box><size>0.0050 0.1000 0.0200</size></box></geometry>
        </collision>
        <visual name="wall_1_visual">
          <pose>-0.0475 0.0000 0.0100 0 0 0</pose>
          <geometry><box><size>0.0050 0.1000 0.0200</size></box></geometry>
          <material>
            <ambient>0.8 0.1 0.1 1.0</ambient>
            <diffuse>0.8 0.1 0.1 1.0</diffuse>
          </material>
        </visual>
        <collision name="wall_2_collision">
          <pose>0.0000 0.0475 0.0100 0 0 0</pose>
          <geometry><box><size>0.0900 0.0050 0.0200</size></box></geometry>
        </collision>
        <visual name="wall_2_visual">
          <pose>0.0000 0.0475 0.0100 0 0 0</pose>
          <geometry><box><size>0.0900 0.0050 0.0200</size></box></geometry>
          <material>
            <ambient>0.8 0.1 0.1 1.0</ambient>
            <diffuse>0.8 0.1 0.1 1.0</diffuse>
          </material>
        </visual>
        <collision name="wall_3_collision">
          <pose>0.0000 -0.0475 0.0100 0 0 0</pose>
          <geometry><box><size>0.0900 0.0050 0.0200</size></box></geometry>
        </collision>
        <visual name="wall_3_visual">
          <pose>0.0000 -0.0475 0.0100 0 0 0</pose>
          <geometry><box><size>0.0900 0.0050 0.0200</size></box></geometry>
          <material>
            <ambient>0.8 0.1 0.1 1.0</ambient>
            <diffuse>0.8 0.1 0.1 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="blue_bin">
      <static>true</static>
      <pose>0.0350 0.2000 0.75 0 0 1.59</pose>
      <link name="link">
        <collision name="wall_0_collision">
          <pose>0.0475 0.0000 0.0100 0 0 0</pose>
          <geometry><box><size>0.0050 0.1000 0.0200</size></box></geometry>
        </collision>
        <visual name="wall_0_visual">
          <pose>0.0475 0.0000 0.0100 0 0 0</pose>
          <geometry><box><size>0.0050 0.1000 0.0200</size></box></geometry>
          <material>
            <ambient>0.1 0.1 0.8 1.0</ambient>
            <diffuse>0.1 0.1 0.8 1.0</diffuse>
          </material>
        </visual>
        <collision name="wall_1_collision">
          <pose>-0.0475 0.0000 0.0100 0 0 0</pose>
          <geometry><box><size>0.0050 0.1000 0.0200</size></box></geometry>
        </collision>
        <visual name="wall_1_visual">
          <pose>-0.0475 0.0000 0.0100 0 0 0</pose>
          <geometry><box><size>0.0050 0.1000 0.0200</size></box></geometry>
          <material>
            <ambient>0.1 0.1 0.8 1.0</ambient>
            <diffuse>0.1 0.1 0.8 1.0</diffuse>
          </material>
        </visual>
        <collision name="wall_2_collision">
          <pose>0.0000 0.0475 0.0100 0 0 0</pose>
          <geometry><box><size>0.0900 0.0050 0.0200</size></box></geometry>
        </collision>
        <visual name="wall_2_visual">
          <pose>0.0000 0.0475 0.0100 0 0 0</pose>
          <geometry><box><size>0.0900 0.0050 0.0200</size></box></geometry>
          <material>
            <ambient>0.1 0.1 0.8 1.0</ambient>
            <diffuse>0.1 0.1 0.8 1.0</diffuse>
          </material>
        </visual>
        <collision name="wall_3_collision">
          <pose>0.0000 -0.0475 0.0100 0 0 0</pose>
          <geometry><box><size>0.0900 0.0050 0.0200</size></box></geometry>
        </collision>
        <visual name="wall_3_visual">
          <pose>0.0000 -0.0475 0.0100 0 0 0</pose>
          <geometry><box><size>0.0900 0.0050 0.0200</size></box></geometry>
          <material>
            <ambient>0.1 0.1 0.8 1.0</ambient>
            <diffuse>0.1 0.1 0.8 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════════════════════
         LIGHT
         A directional light source so we can see the scene.
         ══════════════════════════════════════════════════════════════ -->
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

  </world>
</sdf>
